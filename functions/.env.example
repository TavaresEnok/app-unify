# ============================================================
# Cloud Functions — Secrets e Configurações
# ============================================================
# As variáveis sensíveis (secrets) devem ser configuradas via
# Firebase Secret Manager, NÃO via arquivo .env em produção.
#
# Comandos para configurar:
#   firebase functions:secrets:set PROXY_URL
#   firebase functions:secrets:set PROXY_SECRET
#   firebase functions:config:set apk.script_path="..."
#   firebase functions:config:set apk.project_root="..."
#
# Para desenvolvimento local com o emulador, crie um arquivo
# functions/.secret.local (não versionar) com:
# ============================================================

PROXY_URL=http://SEU_SERVIDOR_PROXY:3002
PROXY_SECRET=substitua-por-um-secret-forte-gerado-aleatoriamente

# Apenas se usar o gerador de APK nas Cloud Functions
APK_SCRIPT_PATH=
APK_PROJECT_ROOT=
