# Base fixada por digest (não a tag mutável :stable) para builds reproduzíveis e
# para não herdar silenciosamente uma imagem alterada upstream.
# Corresponde a ghcr.io/cirruslabs/flutter:stable em 2026-07-17.
FROM ghcr.io/cirruslabs/flutter:stable@sha256:46691e311715845de03a3ba4753a475476936805b29431b1f00f1816981033f8

USER root

# Install dependencies (Node.js, Python 3, curl)
RUN apt-get update && apt-get install -y \
    nodejs \
    npm \
    python3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Configurar diretório de trabalho igual ao do host para manter compatibilidade com scripts
WORKDIR /home/app/projects/painel_provedores

# Copiar apenas arquivos de dependência primeiro
COPY services/apk-builder/package*.json ./services/apk-builder/

# Instalar dependências do Node (no container)
# Nota: Como montaremos o volume, o node_modules do host será usado se compatível,
# mas rodamos npm install para garantir.
RUN cd services/apk-builder && npm ci --omit=dev

COPY services/apk-builder ./services/apk-builder
COPY scripts/build ./scripts/build
# BuildKit bind source is never committed to an image layer. Exclude signing and
# administrative material before copying the Flutter template into the image.
RUN --mount=type=bind,source=app-flutter/unified,target=/flutter-source \
    mkdir -p app-flutter/unified && \
    tar -C /flutter-source --exclude='.env*' --exclude='*.jks' --exclude='*.keystore' \
      --exclude='key.properties' --exclude='*service-account*' --exclude='*service*Account*' --exclude='*credentials*' \
      --exclude='*.pem' --exclude='*.p12' --exclude='*.pfx' --exclude='*.key' \
      --exclude='.gradle' --exclude='.kotlin' --exclude='.pub-cache' \
      --exclude='.git' --exclude='build' --exclude='.dart_tool' -cf - . | \
    tar -C app-flutter/unified -xf -

# Expor porta do serviço
EXPOSE 8035

# Comando de entrada
CMD ["node", "services/apk-builder/index.js"]
