rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.get('superAdmin', false) == true;
    }

    function isProviderAdmin(providerId) {
      return signedIn() && request.auth.token.get('role', '') == 'providerAdmin' && request.auth.token.get('providerId', '') == providerId;
    }

    function canManageProvider(providerId) {
      return isSuperAdmin() || isProviderAdmin(providerId);
    }

    function isClientOfProvider(providerId) {
      return signedIn() && request.auth.token.get('role', '') == 'subscriber' && request.auth.token.get('providerId', '') == providerId;
    }

    function isOwnFunctionRequest() {
      // A identidade canônica é o requesterUid de topo, que DEVE ser o próprio
      // usuário. Um requesterUid aninhado em payload (usado por alguns clientes)
      // só é aceito se também for o próprio usuário — impedindo forjar a
      // identidade de topo (ex.: um super admin) enquanto satisfaz a regra pelo
      // campo do payload.
      let data = request.resource.data;
      return signedIn() &&
        (isSuperAdmin() || request.auth.token.get('role', '') == 'providerAdmin' ||
         (request.auth.token.get('role', '') == 'subscriber' && data.type in ['CREATE_TICKET', 'REPLY_TO_TICKET'])) &&
        data.keys().hasAll(['requesterUid', 'session', 'createdAt']) &&
        data.createdAt == request.time &&
        data.session.keys().hasOnly(['authTime', 'issuedAt', 'role', 'providerId', 'superAdmin']) &&
        data.session.authTime == request.auth.token.auth_time &&
        data.session.issuedAt == request.auth.token.iat &&
        data.session.role == request.auth.token.get('role', '') &&
        data.session.providerId == request.auth.token.get('providerId', '') &&
        data.session.superAdmin == request.auth.token.get('superAdmin', false) &&
        data.requesterUid == request.auth.uid &&
        (
          !(data.payload is map) ||
          !data.payload.keys().hasAny(['requesterUid']) ||
          data.payload.requesterUid == request.auth.uid
        );
    }

    function isOwnFunctionResponse() {
      // resource == null quando o documento ainda não existe (listener criado antes da Function responder)
      return signedIn() && (resource == null || resource.data.requesterUid == request.auth.uid);
    }

    function canReadTicket(providerId, createdByUid) {
      return signedIn() && (
        isSuperAdmin() ||
        isProviderAdmin(providerId) ||
        request.auth.uid == createdByUid ||
        (isClientOfProvider(providerId) && request.auth.token.get('cpfCnpj', '') == createdByUid)
      );
    }

    function clientSyncFieldsValid() {
      return request.resource.data.keys().hasOnly([
        'fcmToken',
        'authUid',
        'cpfCnpj',
        'providerId',
        'nome',
        'plano',
        'status',
        'lastUpdated'
      ]) && request.resource.data.providerId is string &&
      request.resource.data.authUid == request.auth.uid &&
      request.auth.token.get('role', '') == 'subscriber' &&
      request.resource.data.cpfCnpj == request.auth.token.get('cpfCnpj', '') &&
      // O cliente não pode se auto-registrar em um provedor arbitrário: o
      // providerId gravado DEVE ser o do claim do token (emitido no login pelo
      // proxy-sgp após validação no SGP). Impede acesso cross-tenant (A1).
      request.resource.data.providerId == request.auth.token.get('providerId', '');
    }

    function optionalPublicString(data, key) {
      return !(key in data) || data[key] is string;
    }

    function publicProviderReadable(data) {
      // A blacklist at a few levels cannot prove a legacy map/array is safe.
      // Only this flat, typed branding projection is directly readable. Rich
      // configuration is served by the recursively sanitized HTTP backend.
      // Compatibility of legacy mobile readers is a mandatory release gate.
      return data.keys().hasOnly([
          'id', 'name', 'active', 'layoutType', 'themeColor', 'secondaryColor',
          'backgroundColor', 'textColor', 'logoUrl', 'iconUrl', 'loginQuote',
          'applicationId', 'packageName', 'versionName', 'versionCode',
          'apkUrl', 'appUrl', 'createdAt', 'updatedAt', 'createdByRequestId'
        ])
        && optionalPublicString(data, 'id')
        && optionalPublicString(data, 'name')
        && optionalPublicString(data, 'layoutType')
        && optionalPublicString(data, 'themeColor')
        && optionalPublicString(data, 'secondaryColor')
        && optionalPublicString(data, 'backgroundColor')
        && optionalPublicString(data, 'textColor')
        && optionalPublicString(data, 'logoUrl')
        && optionalPublicString(data, 'iconUrl')
        && optionalPublicString(data, 'loginQuote')
        && optionalPublicString(data, 'applicationId')
        && optionalPublicString(data, 'packageName')
        && optionalPublicString(data, 'versionName')
        && optionalPublicString(data, 'apkUrl')
        && optionalPublicString(data, 'appUrl')
        && optionalPublicString(data, 'createdByRequestId')
        && (!('active' in data) || data.active is bool)
        && (!('versionCode' in data) || data.versionCode is int)
        && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    // All config writes use backend schemas. Firebase Rules cannot recursively
    // validate arbitrary nested maps/arrays; never accept client bypasses.
    // Personalization remains available through UPDATE_PROVIDER_CONFIG RPC.
    // Configurações do provedor — leitura pública necessária para o app carregar
    // tema/logo antes do login do assinante. Escrita restrita a admins.
    match /provedores/{providerId} {
      allow read: if publicProviderReadable(resource.data);
      allow write: if false;
    }

    match /provedores/{providerId}/backups/{backupId} {
      allow read, write: if false;
    }

    match /provedores/{providerId}/diagnostic_results/{resultId} {
      allow read, update, delete: if canManageProvider(providerId);
      allow create: if canManageProvider(providerId) || isClientOfProvider(providerId);
    }

    // Avisos de instabilidade/manutenção — clientes do provedor podem LER (para o
    // app avisar "já sabemos, equipe atuando"); só admins do provedor escrevem.
    match /provedores/{providerId}/incidents/{incidentId} {
      allow read: if canManageProvider(providerId) || isClientOfProvider(providerId);
      allow write: if canManageProvider(providerId);
    }

    // Secrets e backups são backend-only, inclusive nas wildcards coincidentes.
    match /provedores/{providerId}/secrets/{secretId} {
      allow read, write: if false;
    }

    // Wildcard para documentos em subcoleções genéricas do provedor.
    match /provedores/{providerId}/{collection}/{document=**} {
      allow read, write: if isSuperAdmin() && !(collection in ["secrets", "backups"]);
    }

    // Coleção legacy — mantida por retrocompatibilidade
    match /providers/{providerId} {
      allow read: if publicProviderReadable(resource.data);
      allow write: if false;
    }

    match /providers/{providerId}/{collection}/{document=**} {
      allow read, write: if isSuperAdmin() && !(collection in ["secrets", "backups"]);
    }

    // Clientes: leitura restrita ao admin do provedor, superAdmin, ou ao próprio cliente
    match /clientes/{clientId} {
      allow read: if isSuperAdmin() || isProviderAdmin(resource.data.providerId) || (signedIn() && request.auth.uid == clientId);
      allow create: if signedIn() && (
        isSuperAdmin() ||
        isProviderAdmin(request.resource.data.providerId) ||
        (request.auth.uid == clientId && clientSyncFieldsValid())
      );
      allow update: if signedIn() && (
        isSuperAdmin()
        || isProviderAdmin(resource.data.providerId)
        || (request.auth.uid == clientId && clientSyncFieldsValid() && resource.data.providerId == request.resource.data.providerId)
      );
      allow delete: if isSuperAdmin() || isProviderAdmin(resource.data.providerId);
    }

    // Fila de operações privilegiadas — apenas criação pelo próprio usuário
    match /function_requests/{requestId} {
      allow create: if isOwnFunctionRequest();
      allow read, update, delete: if false;
    }

    // Respostas das Cloud Functions — leitura apenas pelo solicitante
    match /function_responses/{responseId} {
      allow read: if isOwnFunctionResponse();
      allow create, update, delete: if false;
    }

    // Tickets — leitura por quem tem relação com o ticket; escrita apenas pelas Functions
    match /tickets/{ticketId} {
      allow read: if canReadTicket(resource.data.providerId, resource.data.createdByUid);
      allow create, update, delete: if false;
    }

    match /tickets/{ticketId}/messages/{messageId} {
      allow read: if canReadTicket(
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.providerId,
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdByUid
      );
      allow create, update, delete: if false;
    }

    // Notificações — admins do provedor/superAdmin leem tudo; um cliente só lê as
    // notificações direcionadas ao próprio CPF ou os broadcasts do seu provedor
    // (targetCpf == null). Impede um cliente enumerar CPFs (targetCpf) e UIDs de
    // admin (sentBy) de terceiros (M2). Escrita apenas pelas Functions.
    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || isProviderAdmin(resource.data.providerId)
        || (signedIn() && request.auth.token.get('role', '') == 'subscriber' && resource.data.providerId == request.auth.token.get('providerId', '') && resource.data.targetCpf == request.auth.token.get('cpfCnpj', ''))
        || (signedIn() && resource.data.targetCpf == null && isClientOfProvider(resource.data.providerId));
      allow write: if false;
    }

    // Usuários admin — leitura apenas por superAdmin; escrita pelas Functions
    match /users/{userId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /audit_logs/{auditId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /maintenance_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
