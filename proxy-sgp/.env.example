# ============================================================
# proxy-sgp — Variáveis de Ambiente
# ============================================================
# Copie para .env e preencha. NUNCA versionar o .env.
#
# O PROXY_SECRET deve ser EXATAMENTE o mesmo valor configurado
# no Firebase Secret Manager para a Cloud Function.
# Para obter o valor atual:
#   firebase functions:secrets:access PROXY_SECRET --project SEU_PROJETO
# ============================================================

# Secret compartilhado com as Cloud Functions (deve ser idêntico ao Firebase Secret Manager)
PROXY_SECRET=

# Credenciais SGP padrão do servidor (fallback se o app não enviar sgpParams — opcional)
SGP_TOKEN=
SGP_APP_NAME=
# Opcional: URL base do SGP quando o cliente não envia sgpBaseUrl
# SGP_BASE_URL=https://seudominio.sgp.net.br

# Mock de CPF apenas para desenvolvimento (NUNCA true em produção)
# ENABLE_DEV_CPF_MOCK=false
# DEV_MOCK_CPF=

# Porta do servidor (padrão: 3002)
PORT=3002

# Origens web permitidas no CORS, separadas por virgula.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8031
