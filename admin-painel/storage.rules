rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permite que qualquer usuário autenticado envie imagens para a pasta de tickets
    // A segurança é baseada em que apenas o frontend conhece o caminho correto e as regras do firestore protegem o ticket.
    match /tickets/{ticketId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
