# ============================================================
# Admin Painel — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o arquivo .env — ele está no .gitignore.
# Os valores abaixo podem ser encontrados no Firebase Console:
# Project Settings > Your Apps > Web App > SDK Setup and Configuration
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# URL do api-service (BFF local ou servidor dedicado)
VITE_API_URL=http://localhost:9136
