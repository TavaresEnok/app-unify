// ARQUIVO: ~/proxy-sgp/index.js (VERSÃO FINAL COM URL SGP DINÂMICA)

const express = require('express');
const cors = require('cors');
const bodyParser = require('body-parser');
const { spawn } = require('child_process');
const sqlite3 = require('sqlite3').verbose();

const app = express();
app.use(cors());
app.use(bodyParser.json());

const PROXY_SECRET_KEY = "CHAVE_SECRETA_MUITO_FORTE_12345"; // Mantenha sua chave segura
const DB_FILE_PATH = './cache.db'; 
// Caminho para o banco de dados SQLite

// Conecta ao banco de dados SQLite
const db = new sqlite3.Database(DB_FILE_PATH, (err) => {
    if (err) {
        console.error("Erro ao abrir o banco de dados:", err.message);
    } else {
        console.log("Conectado ao banco de dados SQLite 'cache.db'.");
    }
});

// Função para executar o script PHP proxy
function executePhp(params) {
    return new Promise((resolve, reject) => {
        const phpProcess = spawn('php', ['proxy.php']); // Certifique-se que 'proxy.php' está na mesma pasta
        let stdoutData = '';
        let stderrData = '';
        phpProcess.stdout.on('data', (data) => { stdoutData += data.toString(); });
        phpProcess.stderr.on('data', (data) => { stderrData += data.toString(); });
        phpProcess.on('close', (code) => {
            if (code !== 0 || stderrData) {
                console.error("Erro no processo PHP:", stderrData || `Código de saída ${code}`);
                return reject(new Error(stderrData || `Processo PHP terminou com código ${code}`));
            }
            try {
                // Tenta parsear a resposta como JSON
                resolve(JSON.parse(stdoutData));
            } catch (e) {
                console.error("Resposta inválida (não JSON) do PHP:", stdoutData);
                reject(new Error(`Resposta inválida do PHP: ${stdoutData}`));
            }
        });
        // Envia os parâmetros para o PHP via stdin
        phpProcess.stdin.write(JSON.stringify({ params }));
        phpProcess.stdin.end();
    });
}

// Helper para garantir que a URL Base do SGP seja formatada corretamente
function formatSgpUrl(sgpBaseUrl, path) {
    let base = sgpBaseUrl.trim().replace(/\/$/, ''); // Remove barra final se existir
    return `${base}${path}`;
}


// ROTA 5: BUSCAR DADOS DE CONSUMO (APP FLUTTER)
app.post('/get-consumption-data', async (req, res) => {
    // CORREÇÃO: Adicionando sgpBaseUrl ao payload
    const { cpfCnpj, senha, sgpParams, sgpBaseUrl } = req.body; 

    if (!cpfCnpj || !senha || !sgpParams || !sgpBaseUrl) {
        return res.status(400).json({ error: { message: "cpfCnpj, senha, sgpParams e sgpBaseUrl são obrigatórios." } });
    }

    try {
        console.log(`[Consumo] Buscando dados de consumo para: ${cpfCnpj} no SGP: ${sgpBaseUrl}`);

        // 1. Consulta dados básicos do cliente para obter o ID do contrato
        const consultaParams = {
            ...sgpParams,
            cpfcnpj: cpfCnpj,
            // URL DINÂMICA
            url: formatSgpUrl(sgpBaseUrl, '/ws/ura/consultacliente/')
        };
        const consultaResponse = await executePhp(consultaParams);

        if (!consultaResponse || !Array.isArray(consultaResponse.contratos) || consultaResponse.contratos.length === 0) {
           
            console.warn(`[Consumo] Nenhum contrato encontrado para ${cpfCnpj}`);
            return res.status(404).json({ error: { message: "Nenhum contrato encontrado para este cliente." } });
        }
        const contratoId = consultaResponse.contratos[0].contratoId;
        console.log(`[Consumo] Contrato ID encontrado: ${contratoId}`);
        // 2. Busca o extrato de uso usando o contratoId
        const hoje = new Date();
        const mes = hoje.getMonth() + 1;
        const ano = hoje.getFullYear();
        const extratoParams = {
            ...sgpParams,
            cpfcnpj: cpfCnpj,
            senha: senha,
            contrato: contratoId.toString(),
            mes: mes.toString(),
            ano: ano.toString(),
            // URL DINÂMICA
            url: formatSgpUrl(sgpBaseUrl, '/api/central/extratouso/')
        };
        console.log(`[Consumo] Buscando extrato com params:`, extratoParams);
        const extratoResponse = await executePhp(extratoParams);

        // 3. Formata a resposta para o app
        const consumoData = extratoResponse;
        const totalBytes = consumoData?.total ?? 0;
        const usedGb = totalBytes / (1024 * 1024 * 1024);
        const planName = consumoData?.plano ?? "Plano não informado";

        const realData = {
            usedGb: usedGb,
            planName: planName,
            period: `${mes.toString().padStart(2, '0')}/${ano}`,
        };
        console.log(`[Consumo] Dados formatados:`, realData);
        res.status(200).json({ data: realData });

    } catch (error) {
        console.error("Erro na rota /get-consumption-data:", error.message);
        res.status(500).json({ error: { message: error.message || "Erro interno ao buscar dados de consumo." } });
    }
});


// ROTA 1: SINCRONIZAR CLIENTES (PAINEL ADMIN)
app.post('/sync-clients', async (req, res) => {
    // CORREÇÃO: Adicionando sgpBaseUrl ao payload
    const { secret, params, providerId, sgpBaseUrl } = req.body; 
    if (secret !== PROXY_SECRET_KEY) return res.status(403).json({ error: "Acesso não autorizado." });
    if (!providerId || !sgpBaseUrl) return res.status(400).json({ error: "providerId e sgpBaseUrl são obrigatórios." });

    // Cria um nome de tabela seguro
    const tableName = `clients_${providerId.replace(/[^a-zA-Z0-9_]/g, '')}`;
    console.log(`[Sync] Iniciando sincronização para provider: ${providerId} (tabela: ${tableName}). SGP: ${sgpBaseUrl}`);

    try {
        // URL DINÂMICA
        const phpParams = { 
            ...params, 
            url: formatSgpUrl(sgpBaseUrl, '/api/ura/clientes/')
        };
   
        const firstPageData = await executePhp(phpParams);
        // ... restante da lógica de sincronização, paginação e SQLite ...
        
        if (!firstPageData || !firstPageData.paginacao || !firstPageData.paginacao.total) {
             console.error("[Sync] Resposta inválida da API SGP (clientes):", firstPageData);
             throw new Error("API SGP não retornou dados de paginação válidos.");
        }
        
        // ... (resto da lógica de paginação e salvamento no DB, inalterada)
        const totalClients = firstPageData.paginacao.total;
        const limit = parseInt(params.limit) || 100;
        let allClients = firstPageData.clientes || [];
        const totalPages = Math.ceil(totalClients / limit);
        console.log(`[Sync] Total de clientes: ${totalClients}, Limite por página: ${limit}, Total de páginas: ${totalPages}`);

        if (totalPages > 1) {
            console.log(`[Sync] Buscando páginas 2 a ${totalPages}...`);
            const pageTasks = [];
            for (let page = 2; page <= totalPages; page++) {
                const pagedParams = { ...phpParams, offset: ((page - 1) * limit).toString() };
                pageTasks.push(executePhp(pagedParams).catch(err => {
                    console.error(`[Sync] Erro ao buscar página ${page}: ${err.message}`);
                    return { clientes: [] };
                }));
            }
            const remainingPages = await Promise.all(pageTasks);
            remainingPages.forEach(p => { if (p.clientes) allClients = allClients.concat(p.clientes); });
            console.log(`[Sync] Todas as páginas buscadas. Total de clientes obtidos: ${allClients.length}`);
        }

        db.serialize(() => {
            db.run(`DROP TABLE IF EXISTS ${tableName}`, (err) => {
                 if (err) console.error(`[Sync DB] Erro ao dropar tabela ${tableName}: ${err.message}`);
            });
            db.run(`CREATE TABLE IF NOT EXISTS ${tableName} (id INTEGER PRIMARY KEY, nome TEXT, cpfcnpj TEXT, contratos TEXT)`, (err) => {
                 if (err) throw new Error(`[Sync DB] Falha ao criar tabela ${tableName}: ${err.message}`);
                 console.log(`[Sync DB] Tabela ${tableName} criada/garantida.`);
                 const stmt = db.prepare(`INSERT OR REPLACE INTO ${tableName} (id, nome, cpfcnpj, contratos) VALUES (?, ?, ?, ?)`);
       
                 allClients.forEach(client => {
                     if (client && client.id && client.nome && client.cpfcnpj && client.contratos) {
                         stmt.run(client.id, client.nome, client.cpfcnpj, JSON.stringify(client.contratos));
                     } else {
                         console.warn("[Sync DB] Cliente inválido ou incompleto ignorado:", client);
                     }
                 });
                 stmt.finalize((err) => {
                     if (err) {
                         console.error(`[Sync DB] Erro ao finalizar inserção na tabela ${tableName}: ${err.message}`);
                         return res.status(500).json({ error: `Falha ao salvar no DB: ${err.message}` });
       
                     }
                     console.log(`[Sync] Sincronização concluída para ${providerId}! ${allClients.length} clientes processados.`);
                     res.status(200).json({ message: `Sincronização concluída! ${allClients.length} clientes salvos.`, count: allClients.length });
                 });
            });
        });
    } catch (error) {
        console.error(`[Sync] Erro geral na sincronização para ${providerId}:`, error.message);
        res.status(500).json({ error: error.message || "Erro interno na sincronização." });
    }
});


// ROTA 2: BUSCAR CLIENTES DO CACHE (PAINEL ADMIN)
app.post('/get-cached-clients', (req, res) => {
    // ... inalterada ...
    const { secret, providerId } = req.body;
    const { limit = 25, offset = 0, searchTerm = '' } = req.body.params || {};

    if (secret !== PROXY_SECRET_KEY) return res.status(403).json({ error: "Acesso não autorizado." });
    if (!providerId) return res.status(400).json({ error: "providerId é obrigatório." });

    const tableName = `clients_${providerId.replace(/[^a-zA-Z0-9_]/g, '')}`;
    const searchQuery = `%${searchTerm}%`; // Para busca LIKE

    const queryCount = `SELECT COUNT(*) as total FROM ${tableName} WHERE nome LIKE ? OR cpfcnpj LIKE ?`;
    const queryData = `SELECT * FROM ${tableName} WHERE nome LIKE ? OR cpfcnpj LIKE ? LIMIT ? OFFSET ?`;

    db.get(queryCount, [searchQuery, searchQuery], (err, row) => {
        if (err) {
            console.error(`[Cache] Erro ao contar clientes na tabela ${tableName}:`, err.message);
            return res.status(500).json({ error: `Erro ao buscar contagem de clientes: ${err.message}` });
        }
        const total = row ? row.total : 0;
        db.all(queryData, [searchQuery, searchQuery, limit, offset], (err, rows) => {
            if (err) {
                console.error(`[Cache] Erro ao buscar clientes paginados na tabela ${tableName}:`, err.message);
                return res.status(500).json({ error: `Erro ao buscar clientes: ${err.message}` });
            }
            const clients = rows.map(r => {
                try {
                    return { ...r, contratos: JSON.parse(r.contratos || '[]') }; 
                } catch (e) {
                     console.warn(`[Cache] Erro ao parsear contratos do cliente ${r.id}: ${e.message}`);
                     return { ...r, contratos: [] }; 
                }
            });
            res.status(200).json({ clientes: clients, paginacao: { total: total, limit: limit, offset: offset } });
        });
    });
});

// ROTA 3: BUSCAR UM ÚNICO CLIENTE DO CACHE (PAINEL ADMIN)
app.post('/get-single-client', (req, res) => {
    // ... inalterada ...
    const { secret, providerId, params } = req.body;
    const clientId = params?.clientId;

    if (secret !== PROXY_SECRET_KEY) return res.status(403).json({ error: "Acesso não autorizado." });
    if (!providerId || !clientId) return res.status(400).json({ error: "providerId e clientId são obrigatórios." });

    const tableName = `clients_${providerId.replace(/[^a-zA-Z0-9_]/g, '')}`;
    const query = `SELECT * FROM ${tableName} WHERE id = ?`;

    db.get(query, [clientId], (err, row) => {
     
        if (err) {
             console.error(`[Cache Single] Erro ao buscar cliente ${clientId} na tabela ${tableName}:`, err.message);
             return res.status(500).json({ error: `Erro ao buscar cliente: ${err.message}` });
        }
        if (!row) {
            return res.status(404).json({ error: "Cliente não encontrado no cache local." });
        }
    
        try {
            row.contratos = JSON.parse(row.contratos || '[]');
        } catch (e) {
            console.warn(`[Cache Single] Erro ao parsear contratos do cliente ${row.id}: ${e.message}`);
            row.contratos = [];
        }
        res.status(200).json(row);
    });
});


// ROTA 4: LOGIN (CORRIGIDA PARA BUSCAR FATURA REAL ABERTA)
app.post('/get-client-data-for-login', async (req, res) => {
    // CORREÇÃO: Adicionando sgpBaseUrl ao payload
    const { cpfCnpj, sgpParams, sgpBaseUrl } = req.body;
    const cpfCnpjUnformatted = cpfCnpj ? cpfCnpj.replace(/[^0-9]/g, '') : '';

    if (!cpfCnpjUnformatted || !sgpParams || !sgpBaseUrl) {
        return res.status(400).json({ error: { message: "CPF/CNPJ, sgpParams e sgpBaseUrl são obrigatórios." } });
    }
    console.log(`[Login] Iniciando login para: ${cpfCnpjUnformatted} no SGP: ${sgpBaseUrl}`);

    try {
       
        // 1. Busca dados básicos do cliente
        const consultaParams = {
            ...sgpParams,
            cpfcnpj: cpfCnpjUnformatted,
            // URL DINÂMICA
            url: formatSgpUrl(sgpBaseUrl, '/ws/ura/consultacliente/')
        };
        console.log(`[Login] Buscando dados básicos...`);
        const clientDataSgp = await executePhp(consultaParams);

        if (!clientDataSgp || !Array.isArray(clientDataSgp.contratos) || clientDataSgp.contratos.length === 0) {
            console.warn(`[Login] Nenhum contrato encontrado para ${cpfCnpjUnformatted}`);
            return res.status(404).json({ error: { message: "Nenhum contrato encontrado para este cliente no SGP." } });
        }
        const contrato = clientDataSgp.contratos[0];
        console.log(`[Login] Dados básicos encontrados. Contrato ID: ${contrato.contratoId}, Status: ${contrato.contratoStatusDisplay}`);

        // 2. Tenta buscar a primeira fatura ABERTA real (se houver)
        let firstOpenInvoice = null;
        try {
            const faturaParams = {
                ...sgpParams,
                cpfcnpj: cpfCnpjUnformatted,
                status: 'abertos',
                limit: '1',       
                offset: '0',
                // URL DINÂMICA
                url: formatSgpUrl(sgpBaseUrl, '/api/ura/titulos/')
            };
            console.log(`[Login] Buscando primeira fatura aberta...`);
            const faturaResponse = await executePhp(faturaParams);
            if (faturaResponse?.titulos && Array.isArray(faturaResponse.titulos) && faturaResponse.titulos.length > 0) {
                firstOpenInvoice = faturaResponse.titulos[0];
                console.log(`[Login] Primeira fatura aberta encontrada: Venc=${firstOpenInvoice.dataVencimento}, Valor=${firstOpenInvoice.valor}`);
            } else {
                console.log(`[Login] Nenhuma fatura aberta encontrada.`);
            }
        } catch (faturaError) {
            console.error("[Login] Aviso: Erro ao buscar fatura em aberto durante o login:", faturaError.message);
        }

        // 3. Formata a resposta final para o app
        const formattedData = {
            cpfCnpj: contrato.cpfCnpj,
            senha: contrato.contratoCentralSenha,
            userName: contrato.razaoSocial,
            userPlan: contrato.servico_plano,
          
            userStatus: contrato.contratoStatusDisplay,
            billValue: `R$ ${parseFloat(firstOpenInvoice?.valor ?? contrato.contratoValorAberto ?? 0).toFixed(2).replace('.', ',')}`,
            billDueDate: firstOpenInvoice?.dataVencimento ? `Vence em ${firstOpenInvoice.dataVencimento}` : 'Nenhuma fatura em aberto',
        };
        console.log(`[Login] Dados formatados para o app:`, formattedData);
        res.status(200).json({ data: formattedData });
    } catch (error) {
        console.error("Erro geral na rota /get-client-data-for-login:", error.message);
        res.status(500).json({ error: { message: error.message || "Erro interno ao processar login." } });
    }
});


// ROTA 6: BUSCAR FATURAS (APP FLUTTER)
app.post('/get-invoices', async (req, res) => {
    // CORREÇÃO: Adicionando sgpBaseUrl ao payload
    const { cpfCnpj, sgpParams, sgpBaseUrl } = req.body; 
    const cpfCnpjUnformatted = cpfCnpj ? cpfCnpj.replace(/[^0-9]/g, '') : '';

    if (!cpfCnpjUnformatted || !sgpParams || !sgpBaseUrl) {
        return res.status(400).json({ error: { message: "cpfCnpj, sgpParams e sgpBaseUrl são obrigatórios." } });
    }
    console.log(`[Faturas] Buscando faturas para: ${cpfCnpjUnformatted} no SGP: ${sgpBaseUrl}`);

    try {
        // URL DINÂMICA
        const url = formatSgpUrl(sgpBaseUrl, '/api/ura/titulos/');
        // Parâmetros para buscar faturas abertas e pagas
        const paramsAbertos = { ...sgpParams, cpfcnpj: cpfCnpjUnformatted, status: 'abertos', url };
        const paramsPagos = { ...sgpParams, cpfcnpj: cpfCnpjUnformatted, status: 'pagos', url };

        console.log(`[Faturas] Buscando abertas e pagas em paralelo...`);
        const [responseAbertos, responsePagos] = await Promise.all([
             executePhp(paramsAbertos).catch(err => { console.error(`[Faturas] Erro ao buscar abertas: ${err.message}`); return { titulos: [] }; }),
             executePhp(paramsPagos).catch(err => { console.error(`[Faturas] Erro ao buscar pagas: ${err.message}`); return { titulos: [] }; })
        ]);
        // ... restante da lógica de formatação de faturas ...
        let formattedInvoices = [];

        if (responseAbertos?.titulos && Array.isArray(responseAbertos.titulos)) {
             console.log(`[Faturas] ${responseAbertos.titulos.length} faturas abertas encontradas.`);
             formattedInvoices.push(...responseAbertos.titulos.map(inv => ({
                 ...inv,
                 pago: false, 
                 valor: parseFloat(inv.valor ?? 0).toFixed(2).replace('.',',')
             })));
        } else {
             console.log(`[Faturas] Nenhuma fatura aberta encontrada ou erro na busca.`);
        }

        if (responsePagos?.titulos && Array.isArray(responsePagos.titulos)) {
             console.log(`[Faturas] ${responsePagos.titulos.length} faturas pagas encontradas.`);
             formattedInvoices.push(...responsePagos.titulos.map(inv => ({
                 ...inv,
                 pago: true,
                 valor: parseFloat(inv.valor ?? 0).toFixed(2).replace('.',',')
            })));
        } else {
             console.log(`[Faturas] Nenhuma fatura paga encontrada ou erro na busca.`);
        }

        console.log(`[Faturas] Total de faturas formatadas: ${formattedInvoices.length}`);
        res.status(200).json({ data: formattedInvoices });
    } catch (error) {
        console.error("Erro geral na rota /get-invoices:", error.message);
        res.status(500).json({ error: { message: error.message || "Erro interno ao buscar faturas." } });
    }
});


// ROTA 7: PROMESSA DE PAGAMENTO (APP FLUTTER)
app.post('/make-payment-promise', async (req, res) => {
    // CORREÇÃO: Adicionando sgpBaseUrl ao payload
    const { cpfCnpj, sgpParams, sgpBaseUrl } = req.body; 
    const cpfCnpjUnformatted = cpfCnpj ? cpfCnpj.replace(/[^0-9]/g, '') : '';

    if (!cpfCnpjUnformatted || !sgpParams || !sgpBaseUrl) {
        return res.status(400).json({ error: { message: "cpfCnpj, sgpParams e sgpBaseUrl são obrigatórios." } });
    }
     console.log(`[Promessa] Iniciando para: ${cpfCnpjUnformatted} no SGP: ${sgpBaseUrl}`);

    try {
        // 1. Consulta cliente para obter ID do contrato
        const consultaParams = {
             ...sgpParams,
             cpfcnpj: cpfCnpjUnformatted,
             // URL DINÂMICA
             url: formatSgpUrl(sgpBaseUrl, '/ws/ura/consultacliente/')
        };
        console.log(`[Promessa] Buscando contrato...`);
        const consultaResponse = await executePhp(consultaParams);

        if (!consultaResponse || !Array.isArray(consultaResponse.contratos) || consultaResponse.contratos.length === 0) {
             console.warn(`[Promessa] Nenhum contrato encontrado para ${cpfCnpjUnformatted}`);
             return res.status(404).json({ error: { message: "Nenhum contrato encontrado para este cliente." } });
        }
        const contratoId = consultaResponse.contratos[0].contratoId;
        console.log(`[Promessa] Contrato ID: ${contratoId}`);
        // 2. Chama API de liberação de promessa
        const promessaParams = {
             ...sgpParams,
             contrato: contratoId.toString(),
             // URL DINÂMICA
             url: formatSgpUrl(sgpBaseUrl, '/api/ura/liberacaopromessa/')
        };
        console.log(`[Promessa] Solicitando liberação...`);
        const promessaResponse = await executePhp(promessaParams);
        console.log(`[Promessa] Resposta SGP:`, promessaResponse);

        if (promessaResponse?.status === false) {
             console.warn(`[Promessa] Falha na liberação: ${promessaResponse.msg}`);
             return res.status(400).json({ error: { message: promessaResponse.msg || "Não foi possível realizar a promessa no momento." } });
        }

        // Sucesso
        console.log(`[Promessa] Sucesso: ${promessaResponse?.msg}`);
        res.status(200).json({ success: true, message: promessaResponse?.msg || "Promessa realizada com sucesso! Sua conexão será reestabelecida em breve." });
    } catch (error) {
        console.error("Erro geral na rota /make-payment-promise:", error.message);
        res.status(500).json({ error: { message: error.message || "Erro interno ao processar promessa." } });
    }
});


