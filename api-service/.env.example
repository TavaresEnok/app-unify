# ============================================================
# api-service — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o arquivo .env — ele está no .gitignore.
# ============================================================

# Porta do servidor Express (padrão: 9136)
PORT=9136

# Firebase — Credenciais de Conta de Serviço
# Em produção no Google Cloud (Cloud Run, GCE, GKE) as credenciais são
# obtidas automaticamente via Application Default Credentials (ADC).
# Em ambiente local, aponte para um arquivo de SA key gerado no console:
# https://console.firebase.google.com > Project Settings > Service Accounts > Generate new private key
# NUNCA versione o arquivo de SA key!
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/sua/service-account-key.json

# Firebase Web API Key (para proxy de login — Identity Toolkit)
# Encontrado em: Firebase Console > Project Settings > General > Web API Key
FIREBASE_API_KEY=

# Origens permitidas no CORS, separadas por virgula. Com proxy de mesma origem,
# normalmente apenas as origens de desenvolvimento precisam ser listadas.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8031

# Credenciais SGP
SGP_TOKEN=
SGP_APP_NAME=
