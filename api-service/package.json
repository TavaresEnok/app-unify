{
  "name": "api-service",
  "version": "1.0.0",
  "description": "API service for SGP integration",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"for (const file of ['upstream-runtime.js','invoice-amount.js','subscriber-segments-ddl.js','ixc-gateway.js','core-schema-ddl.js','self-auth.js','legacy-firebase-auth.js']) require('fs').copyFileSync('src/services/'+file,'dist/services/'+file)\"",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure:capacity": "vitest run --config vitest.capacity.config.mts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^13.6.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "fast-xml-parser": "^5.12.0"
  }
}
